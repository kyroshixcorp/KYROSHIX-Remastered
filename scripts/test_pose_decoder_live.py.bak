"""KYROSHIX BOT - Live Pose Grid Decoder

Robust live scanner for ProjectGabriel/PoseExfilScreen.

The shader draws a 34 x 2 grid:

    TOP / forward:
        data[0..31] | GREEN | RED

    BOTTOM / position:
        data[0..31] | RED   | GREEN

The scanner:
    - captures every physical monitor with MSS
    - searches several possible physical cell sizes
    - tolerates render scaling / antialiasing
    - detects the 2x2 marker using sampled regions
    - tries small alignment corrections
    - decodes the complete pose
    - optionally watches the pose continuously

Usage:

    .venv\\Scripts\\python.exe scripts\\test_pose_decoder_live.py

    .venv\\Scripts\\python.exe scripts\\test_pose_decoder_live.py --cell 4

    .venv\\Scripts\\python.exe scripts\\test_pose_decoder_live.py --watch

    .venv\\Scripts\\python.exe scripts\\test_pose_decoder_live.py --cell 4 --watch

    .venv\\Scripts\\python.exe scripts\\test_pose_decoder_live.py --debug
"""

from __future__ import annotations

import argparse
import sys
import time
from pathlib import Path


# ---------------------------------------------------------------------------
# Project imports
# ---------------------------------------------------------------------------

ROOT = Path(__file__).resolve().parent.parent

if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


from src.pose_decoder import (  # noqa: E402
    DEFAULT_CELL_SIZE,
    GRID_W,
    GRID_H,
    decode_strip,
)


# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

BIT_THRESHOLD = 127

# How far around a candidate origin we try to compensate for fractional
# scaling / imperfect alignment.
ALIGN_TOLERANCE = 3

# Search these sizes in addition to the requested cell size.
COMMON_CELL_SIZES = (2, 3, 4, 5, 6, 7, 8, 10, 12, 16)

# Minimum confidence for considering a sampled region RED/GREEN.
COLOR_SCORE_THRESHOLD = 0.45


# ---------------------------------------------------------------------------
# Utility
# ---------------------------------------------------------------------------

def _candidate_cell_sizes(preferred: int) -> list[int]:
    """Build an ordered list of physical cell sizes to test."""

    preferred = max(1, int(preferred))

    values = [
        preferred,
        preferred - 1,
        preferred + 1,
        preferred - 2,
        preferred + 2,
        preferred * 2,
        max(1, preferred // 2),
        *COMMON_CELL_SIZES,
    ]

    result: list[int] = []

    for value in values:
        value = int(value)

        if value < 2:
            continue

        if value not in result:
            result.append(value)

    return result


def _rgb_masks(arr):
    """Return tolerant RED and GREEN masks for a BGRA MSS image."""

    import numpy as np

    b = arr[..., 0].astype(np.int16)
    g = arr[..., 1].astype(np.int16)
    r = arr[..., 2].astype(np.int16)

    # Deliberately tolerant thresholds.
    #
    # We care more about channel dominance than exact 255/0 values because
    # VRChat / Unity / render scaling may slightly modify the final pixels.

    red = (
        (r >= 120)
        & ((r - g) >= 50)
        & ((r - b) >= 50)
    )

    green = (
        (g >= 120)
        & ((g - r) >= 50)
        & ((g - b) >= 50)
    )

    return red, green


def _region_score(mask, x: int, y: int, size: int) -> float:
    """Return fraction of pixels matching mask inside a cell."""

    h, w = mask.shape

    if size <= 0:
        return 0.0

    x0 = max(0, x)
    y0 = max(0, y)

    x1 = min(w, x + size)
    y1 = min(h, y + size)

    if x0 >= x1 or y0 >= y1:
        return 0.0

    region = mask[y0:y1, x0:x1]

    if region.size == 0:
        return 0.0

    return float(region.mean())


def _center_score(mask, cx: int, cy: int, radius: int = 1) -> float:
    """Score a small area around a cell center."""

    h, w = mask.shape

    x0 = max(0, cx - radius)
    x1 = min(w, cx + radius + 1)

    y0 = max(0, cy - radius)
    y1 = min(h, cy + radius + 1)

    if x0 >= x1 or y0 >= y1:
        return 0.0

    region = mask[y0:y1, x0:x1]

    if region.size == 0:
        return 0.0

    return float(region.mean())


# ---------------------------------------------------------------------------
# Grid sampling
# ---------------------------------------------------------------------------

def sample_grid(arr, left: int, top: int, cell: int):
    """Sample GRID_W x GRID_H cells.

    MSS image is BGRA and top-down.

    The shader layout on screen is:

        top row    = forward
        bottom row = position

    decode_strip expects:

        row 0 = position
        row 1 = forward

    Therefore sampling is performed bottom-up.
    """

    h, w = arr.shape[:2]

    left = int(left)
    top = int(top)
    cell = int(cell)

    if cell <= 0:
        return None

    grid_width = GRID_W * cell
    grid_height = GRID_H * cell

    if left < 0 or top < 0:
        return None

    if left + grid_width > w:
        return None

    if top + grid_height > h:
        return None

    pixels = bytearray()

    for row in range(GRID_H):

        # Flip visual row order:
        #
        # decoder row 0 -> bottom screen row
        # decoder row 1 -> top screen row

        visual_row = GRID_H - 1 - row

        cy = top + visual_row * cell + cell // 2

        for col in range(GRID_W):

            cx = left + col * cell + cell // 2

            if cx < 0 or cy < 0 or cx >= w or cy >= h:
                return None

            px = arr[cy, cx]

            # MSS = BGRA
            # decoder = RGB

            pixels.extend(
                [
                    int(px[2]),
                    int(px[1]),
                    int(px[0]),
                ]
            )

    return bytes(pixels)


# ---------------------------------------------------------------------------
# Marker validation
# ---------------------------------------------------------------------------

def _marker_score(
    red_mask,
    green_mask,
    marker_x: int,
    marker_y: int,
    cell: int,
) -> float:
    """Score expected marker:

            GREEN | RED
            ------+------
             RED  | GREEN
    """

    half = cell // 2

    centers = (
        # mask, x, y
        (
            green_mask,
            marker_x + half,
            marker_y + half,
        ),
        (
            red_mask,
            marker_x + cell + half,
            marker_y + half,
        ),
        (
            red_mask,
            marker_x + half,
            marker_y + cell + half,
        ),
        (
            green_mask,
            marker_x + cell + half,
            marker_y + cell + half,
        ),
    )

    radius = max(0, min(2, cell // 3))

    scores = []

    for mask, cx, cy in centers:
        scores.append(
            _center_score(
                mask,
                cx,
                cy,
                radius=radius,
            )
        )

    return sum(scores) / len(scores)


def _marker_region_score(
    red_mask,
    green_mask,
    marker_x: int,
    marker_y: int,
    cell: int,
) -> float:
    """Secondary marker test using complete cell regions."""

    scores = [
        _region_score(
            green_mask,
            marker_x,
            marker_y,
            cell,
        ),
        _region_score(
            red_mask,
            marker_x + cell,
            marker_y,
            cell,
        ),
        _region_score(
            red_mask,
            marker_x,
            marker_y + cell,
            cell,
        ),
        _region_score(
            green_mask,
            marker_x + cell,
            marker_y + cell,
            cell,
        ),
    ]

    return sum(scores) / 4.0


# ---------------------------------------------------------------------------
# Grid finder
# ---------------------------------------------------------------------------

def find_grid_origin(
    arr,
    cell: int,
    max_hits: int = 10,
    debug: bool = False,
):
    """Locate possible PoseExfil grid origins.

    Unlike the original implementation, this does NOT require a perfectly
    solid green rectangle.

    It searches for strongly green pixels and tests several physical cell
    sizes around them.

    Returns:

        [(left, top, cell_size), ...]
    """

    import numpy as np

    red_mask, green_mask = _rgb_masks(arr)

    h, w = green_mask.shape

    cell_sizes = _candidate_cell_sizes(cell)

    if debug:
        print(
            "  scanner cell sizes:",
            ", ".join(str(v) for v in cell_sizes),
        )

    # Find green pixels.
    ys, xs = np.where(green_mask)

    if len(xs) == 0:
        if debug:
            print("  debug: no sufficiently green pixels found")
        return []

    # The HUD is expected to be near a screen edge and normally near the
    # bottom-left. Searching every green pixel in a 4K game frame can be
    # unnecessarily expensive.
    #
    # Prefer pixels in the outer screen area first.

    edge_mask = (
        (xs < int(w * 0.35))
        | (xs > int(w * 0.65))
        | (ys < int(h * 0.20))
        | (ys > int(h * 0.80))
    )

    edge_xs = xs[edge_mask]
    edge_ys = ys[edge_mask]

    if len(edge_xs):
        search_xs = edge_xs
        search_ys = edge_ys
    else:
        search_xs = xs
        search_ys = ys

    candidates = []
    seen = set()

    # Avoid testing millions of identical nearby pixels.
    #
    # Subsample if necessary.

    max_green_samples = 50000

    if len(search_xs) > max_green_samples:
        step = max(1, len(search_xs) // max_green_samples)

        search_xs = search_xs[::step]
        search_ys = search_ys[::step]

    for test_cell in cell_sizes:

        half = test_cell // 2

        for gy, gx in zip(
            search_ys.tolist(),
            search_xs.tolist(),
        ):

            # Assume this green pixel is somewhere around the center of
            # marker cell [top row, column 32].

            approximate_x = gx - half
            approximate_y = gy - half

            for dy in range(
                -ALIGN_TOLERANCE,
                ALIGN_TOLERANCE + 1,
            ):

                marker_y = approximate_y + dy

                if marker_y < 0:
                    continue

                if marker_y + (2 * test_cell) > h:
                    continue

                for dx in range(
                    -ALIGN_TOLERANCE,
                    ALIGN_TOLERANCE + 1,
                ):

                    marker_x = approximate_x + dx

                    if marker_x < 0:
                        continue

                    if marker_x + (2 * test_cell) > w:
                        continue

                    center_score = _marker_score(
                        red_mask,
                        green_mask,
                        marker_x,
                        marker_y,
                        test_cell,
                    )

                    # Require reasonable center confidence.
                    if center_score < 0.70:
                        continue

                    region_score = _marker_region_score(
                        red_mask,
                        green_mask,
                        marker_x,
                        marker_y,
                        test_cell,
                    )

                    # Some filtering/scaling can destroy cell borders,
                    # therefore region score is deliberately permissive.
                    if region_score < COLOR_SCORE_THRESHOLD:
                        continue

                    # Marker begins at grid column 32.

                    left = marker_x - (32 * test_cell)
                    top = marker_y

                    if left < 0:
                        continue

                    if left + (GRID_W * test_cell) > w:
                        continue

                    if top + (GRID_H * test_cell) > h:
                        continue

                    key = (
                        int(left),
                        int(top),
                        int(test_cell),
                    )

                    if key in seen:
                        continue

                    seen.add(key)

                    candidates.append(
                        (
                            int(left),
                            int(top),
                            int(test_cell),
                        )
                    )

                    if debug:
                        print(
                            "  candidate:"
                            f" left={left}"
                            f" top={top}"
                            f" cell={test_cell}"
                            f" center={center_score:.2f}"
                            f" region={region_score:.2f}"
                        )

                    if len(candidates) >= max_hits:
                        return candidates

    return candidates


# ---------------------------------------------------------------------------
# Debug printing
# ---------------------------------------------------------------------------

def print_raw_grid(pixels):
    """Print decoded RGB bit state for every sampled cell."""

    for row in range(GRID_H):

        cells = []

        for col in range(GRID_W):

            idx = (row * GRID_W + col) * 3

            r = pixels[idx]
            g = pixels[idx + 1]
            b = pixels[idx + 2]

            bits = (
                f"{int(r > BIT_THRESHOLD)}"
                f"{int(g > BIT_THRESHOLD)}"
                f"{int(b > BIT_THRESHOLD)}"
            )

            cells.append(bits)

        print(
            f"    row {row}: "
            + " ".join(cells)
        )


# ---------------------------------------------------------------------------
# Decode candidate with alignment correction
# ---------------------------------------------------------------------------

def try_decode_candidate(
    arr,
    left: int,
    top: int,
    cell: int,
    debug: bool = False,
):
    """Try exact origin plus tiny alignment corrections."""

    h, w = arr.shape[:2]

    offsets = [(0, 0)]

    for radius in (1, 2):

        for dy in range(-radius, radius + 1):

            for dx in range(-radius, radius + 1):

                if (dx, dy) not in offsets:
                    offsets.append((dx, dy))

    for dx, dy in offsets:

        test_left = left + dx
        test_top = top + dy

        if test_left < 0 or test_top < 0:
            continue

        if test_left + GRID_W * cell > w:
            continue

        if test_top + GRID_H * cell > h:
            continue

        pixels = sample_grid(
            arr,
            test_left,
            test_top,
            cell,
        )

        if pixels is None:
            continue

        pose = decode_strip(pixels)

        if pose is not None:

            if debug and (dx != 0 or dy != 0):
                print(
                    "  alignment correction:"
                    f" dx={dx:+d}"
                    f" dy={dy:+d}"
                )

            return (
                pose,
                pixels,
                test_left,
                test_top,
            )

    return None


# ---------------------------------------------------------------------------
# Live monitor scan
# ---------------------------------------------------------------------------

def scan_and_decode(
    cell: int,
    debug: bool = False,
):
    """Scan all physical monitors and attempt to decode a pose."""

    try:
        import mss
        import numpy as np

    except ImportError as exc:

        print(
            f"ERROR: missing dependency: {exc}"
        )

        print(
            "Install mss and numpy in the KYROSHIX BOT virtual environment."
        )

        return 1, None, 0, 0, 0

    with mss.mss() as sct:

        physical_monitors = sct.monitors[1:]

        if not physical_monitors:

            print("ERROR: MSS reported no physical monitors.")

            return 1, None, 0, 0, 0

        for monitor_index in range(
            1,
            len(sct.monitors),
        ):

            mon = sct.monitors[monitor_index]

            print(
                f"--- monitor {monitor_index}: "
                f"{mon} ---"
            )

            try:
                shot = sct.grab(mon)

            except Exception as exc:

                print(
                    f"  capture failed: {exc}"
                )

                continue

            arr = np.asarray(
                shot,
                dtype=np.uint8,
            )

            candidates = find_grid_origin(
                arr,
                cell,
                max_hits=20,
                debug=debug,
            )

            if not candidates:

                print(
                    "  no marker pattern found"
                )

                continue

            print(
                f"  found {len(candidates)} "
                "candidate grid origin(s)"
            )

            for left, top, estimated_cell in candidates:

                print(
                    f"  trying origin "
                    f"({left},{top}) "
                    f"cell={estimated_cell}"
                )

                result = try_decode_candidate(
                    arr,
                    left,
                    top,
                    estimated_cell,
                    debug=debug,
                )

                if result is None:

                    # Still print raw sample in debug mode.
                    if debug:

                        pixels = sample_grid(
                            arr,
                            left,
                            top,
                            estimated_cell,
                        )

                        if pixels is not None:
                            print_raw_grid(pixels)

                    print(
                        "    marker candidate found, "
                        "but full pose decode failed"
                    )

                    continue

                (
                    pose,
                    pixels,
                    final_left,
                    final_top,
                ) = result

                abs_x = mon["left"] + final_left
                abs_y = mon["top"] + final_top

                if debug:
                    print_raw_grid(pixels)

                print()
                print(
                    "  ========================================"
                )
                print(
                    "  POSE GRID FOUND"
                )
                print(
                    "  ========================================"
                )

                print(
                    f"  monitor : {monitor_index}"
                )

                print(
                    f"  origin  : "
                    f"({final_left},{final_top})"
                )

                print(
                    f"  absolute: "
                    f"({abs_x},{abs_y})"
                )

                print(
                    f"  cell    : "
                    f"{estimated_cell}px"
                )

                print(
                    f"  position: "
                    f"x={pose.x:+.3f} "
                    f"y={pose.y:+.3f} "
                    f"z={pose.z:+.3f}"
                )

                print(
                    f"  yaw     : "
                    f"{pose.yaw:6.2f} deg"
                )

                print(
                    "  ========================================"
                )
                print()

                return (
                    0,
                    monitor_index,
                    abs_x,
                    abs_y,
                    estimated_cell,
                )

    print()
    print("No grid decoded.")
    print()
    print("The screen was captured successfully, but no")
    print("valid PoseExfil marker + data grid was decoded.")
    print()
    print("Run again with:")
    print()
    print(
        "  python scripts\\test_pose_decoder_live.py "
        "--cell 4 --debug"
    )
    print()

    return 2, None, 0, 0, 0


# ---------------------------------------------------------------------------
# Watch mode
# ---------------------------------------------------------------------------

def watch_pose(
    monitor_index: int,
    abs_x: int,
    abs_y: int,
    cell: int,
    refresh_hz: float = 10.0,
):
    """Continuously decode the already located grid."""

    try:
        import mss
        import numpy as np

    except ImportError as exc:

        print(
            f"ERROR: missing dependency: {exc}"
        )

        return 1

    refresh_hz = max(
        1.0,
        float(refresh_hz),
    )

    delay = 1.0 / refresh_hz

    print()
    print(
        f"Watching pose at {refresh_hz:.1f} Hz."
    )
    print(
        "Move/turn the avatar to verify the values change."
    )
    print(
        "Press Ctrl+C to stop."
    )
    print()

    failures = 0

    with mss.mss() as sct:

        if (
            monitor_index <= 0
            or monitor_index >= len(sct.monitors)
        ):

            print(
                f"ERROR: monitor {monitor_index} no longer exists."
            )

            return 1

        mon = sct.monitors[monitor_index]

        # abs_x/abs_y are desktop coordinates.
        region = {
            "left": int(abs_x),
            "top": int(abs_y),
            "width": int(GRID_W * cell),
            "height": int(GRID_H * cell),
        }

        try:

            while True:

                started = time.monotonic()

                try:

                    shot = sct.grab(region)

                    arr = np.asarray(
                        shot,
                        dtype=np.uint8,
                    )

                    pixels = sample_grid(
                        arr,
                        0,
                        0,
                        cell,
                    )

                    pose = (
                        decode_strip(pixels)
                        if pixels is not None
                        else None
                    )

                except Exception:
                    pose = None

                if pose is not None:

                    failures = 0

                    print(
                        "\r"
                        f"x={pose.x:+8.3f}  "
                        f"y={pose.y:+8.3f}  "
                        f"z={pose.z:+8.3f}  "
                        f"yaw={pose.yaw:7.2f}°   ",
                        end="",
                        flush=True,
                    )

                else:

                    failures += 1

                    print(
                        "\r"
                        f"[decode failed x{failures}]"
                        "                              ",
                        end="",
                        flush=True,
                    )

                elapsed = (
                    time.monotonic()
                    - started
                )

                remaining = delay - elapsed

                if remaining > 0:
                    time.sleep(remaining)

        except KeyboardInterrupt:

            print()
            print("Watch stopped.")

    return 0


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description=(
            "KYROSHIX BOT / ProjectGabriel "
            "live PoseExfil decoder"
        )
    )

    parser.add_argument(
        "--cell",
        type=int,
        default=DEFAULT_CELL_SIZE,
        help=(
            "preferred shader cell size in physical pixels "
            f"(default: {DEFAULT_CELL_SIZE})"
        ),
    )

    parser.add_argument(
        "--watch",
        action="store_true",
        help=(
            "after locating the grid, continuously "
            "decode the avatar pose"
        ),
    )

    parser.add_argument(
        "--hz",
        type=float,
        default=10.0,
        help=(
            "watch refresh rate "
            "(default: 10 Hz)"
        ),
    )

    parser.add_argument(
        "--debug",
        action="store_true",
        help=(
            "print candidate detection and raw grid information"
        ),
    )

    args = parser.parse_args()

    print()
    print("KYROSHIX BOT - Pose Grid Scanner")
    print(
        f"Preferred cell size: {args.cell}px"
    )
    print()

    result = scan_and_decode(
        args.cell,
        debug=args.debug,
    )

    if (
        not isinstance(result, tuple)
        or len(result) < 5
    ):
        return int(result)

    status = result[0]

    if status != 0:
        return status

    (
        _,
        monitor_index,
        abs_x,
        abs_y,
        detected_cell,
    ) = result

    if not args.watch:
        return 0

    return watch_pose(
        monitor_index,
        abs_x,
        abs_y,
        detected_cell,
        refresh_hz=args.hz,
    )


if __name__ == "__main__":
    raise SystemExit(main())