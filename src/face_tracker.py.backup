import gc
import json
import logging
import random
import threading
import time
from pathlib import Path

logger = logging.getLogger(__name__)

MODEL_DIR = "models/yolov8"
FACE_MODEL_NAME = "yolov8n-face.pt"
FACE_MODEL_URL = "https://cdn.barricade.dev/raw/yolov8n-face.pt"

# ---------------------------------------------------------------------------
# KYROSHIX BOT - Face Tracker Performance Configuration
# ---------------------------------------------------------------------------

# YOLO input frame.
FRAME_W = 512
FRAME_H = 288

# OSC/control loop target.
TARGET_FPS = 60

# YOLO inference resolution.
INFERENCE_SIZE = 512

# Face detection does not need to run at the same rate as OSC.
# 30 detections/s + 60 Hz OSC gives smoother movement while reducing GPU load.
DETECTION_FPS = 30

# Short sleep when another movement system owns OSC.
YIELD_SLEEP = 0.05

# Metrics reporting interval.
METRICS_INTERVAL = 10.0

DEFAULT_CFG = {
    "confidence_threshold": 0.35,
    "smoothing_alpha": 0.35,
    "max_turn_rate": 0.10,
    "deadzone": 0.12,
    "turn_gain": 2.0,
    "vertical_gain": 1.2,
    "min_output": 0.35,
    "lock_timeout": 3.0,
    "idle_switch_min": 5.0,
    "idle_switch_max": 10.0,
    "cache_cleanup_interval": 300.0,
}


class FaceTracker:
    """Detect faces on screen and smoothly control VRChat look via OSC."""

    def __init__(self, config, osc=None):
        self.config = config
        self.osc = osc

        self.model = None
        self._device = "cpu"
        self._use_half = False

        self._active = False
        self._thread = None
        self._camera = None

        self._preload_ready = threading.Event()
        self._model_lock = threading.Lock()

        # External state references
        self._speaking_ref = None
        self._idle_ref = None
        self._player_tracker_ref = None
        self._wanderer_ref = None
        self._mapping_service_ref = None

        # Tracking state
        self._locked_id = None
        self._lock_lost_time = None

        self._smoothed_look_h = 0.0
        self._smoothed_look_v = 0.0

        self._last_detections = []

        # Idle behaviour
        self._idle_next_switch = 0.0
        self._idle_target_id = None

        # Configuration
        self._cfg = dict(DEFAULT_CFG)
        self._load_config()

        # Performance metrics
        self._fps = 0.0
        self._frame_count = 0
        self._detection_count = 0

        self._fps_timer = time.perf_counter()

        self._last_capture_ms = 0.0
        self._last_resize_ms = 0.0
        self._last_inference_ms = 0.0

        self._next_cache_cleanup = (
            time.perf_counter()
            + float(
                self._cfg.get(
                    "cache_cleanup_interval",
                    300.0,
                )
            )
        )

    @property
    def active(self):
        return self._active

    def set_speaking_callback(self, callback):
        self._speaking_ref = callback

    def set_idle_callback(self, callback):
        self._idle_ref = callback

    def set_player_tracker(self, tracker):
        self._player_tracker_ref = tracker

    def set_wanderer(self, wanderer):
        self._wanderer_ref = wanderer

    def set_mapping_service(self, mapping_service):
        self._mapping_service_ref = mapping_service

    def _is_speaking(self):
        try:
            if self._speaking_ref is not None:
                return bool(self._speaking_ref())
        except Exception:
            pass

        return False

    def _is_idle(self):
        try:
            if self._idle_ref is not None:
                return bool(self._idle_ref())
        except Exception:
            pass

        return False

    def _player_tracker_active(self):
        try:
            if self._player_tracker_ref is not None:
                return bool(self._player_tracker_ref.active)
        except Exception:
            pass

        return False

    def _wanderer_active(self):
        try:
            if self._wanderer_ref is not None:
                return bool(
                    self._wanderer_ref._active
                    and not self._wanderer_ref._paused
                )
        except Exception:
            pass

        return False

    def _mapping_nav_active(self):
        ms = self._mapping_service_ref

        if ms is None:
            return False

        try:
            if ms.follow_status().get("active"):
                return True

            if getattr(ms, "_pending_align_yaw", None) is not None:
                return True

        except Exception:
            pass

        return False

    # ------------------------------------------------------------------
    # Configuration
    # ------------------------------------------------------------------

    def _load_config(self):
        config_path = Path(MODEL_DIR) / "face_config.json"

        if not config_path.exists():
            return

        try:
            with open(
                config_path,
                "r",
                encoding="utf-8",
            ) as f:
                loaded = json.load(f)

            if isinstance(loaded, dict):
                self._cfg.update(loaded)

        except Exception as e:
            logger.warning(
                f"Failed to load face tracker config: {e}"
            )

    def _save_config(self):
        model_dir = Path(MODEL_DIR)
        model_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        with open(
            model_dir / "face_config.json",
            "w",
            encoding="utf-8",
        ) as f:
            json.dump(
                self._cfg,
                f,
                indent=2,
            )

    # ------------------------------------------------------------------
    # Model
    # ------------------------------------------------------------------

    def preload(self):
        """Pre-load YOLO in a background thread."""

        if self._preload_ready.is_set():
            return

        def _do_preload():
            try:
                logger.debug(
                    "Face tracker: background preload starting..."
                )

                self._ensure_model()

                logger.info(
                    "Face tracker: model ready"
                )

            except Exception as e:
                logger.exception(
                    f"Face tracker preload failed: {e}"
                )

            finally:
                self._preload_ready.set()

        thread = threading.Thread(
            target=_do_preload,
            daemon=True,
            name="face-preload",
        )

        thread.start()

    def _ensure_model(self):
        if self.model is not None:
            return

        with self._model_lock:
            if self.model is not None:
                return

            import numpy as np
            import torch
            from ultralytics import YOLO

            model_dir = Path(MODEL_DIR)

            model_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            model_path = model_dir / FACE_MODEL_NAME

            if not model_path.exists():
                logger.info(
                    f"Downloading {FACE_MODEL_NAME} "
                    f"to {model_dir}..."
                )

                try:
                    import requests

                    response = requests.get(
                        FACE_MODEL_URL,
                        allow_redirects=True,
                        timeout=60,
                    )

                    response.raise_for_status()

                    with open(
                        model_path,
                        "wb",
                    ) as f:
                        f.write(response.content)

                except ImportError:
                    import urllib.request

                    urllib.request.urlretrieve(
                        FACE_MODEL_URL,
                        str(model_path),
                    )

                logger.info(
                    f"Downloaded {FACE_MODEL_NAME} "
                    f"({model_path.stat().st_size / 1024 / 1024:.1f} MB)"
                )

            self.model = YOLO(
                str(model_path)
            )

            if torch.cuda.is_available():
                self._device = "cuda"

                gpu_name = torch.cuda.get_device_name(0)

                vram_gb = (
                    torch.cuda.get_device_properties(0).total_memory
                    / 1024**3
                )

                self.model.to(
                    self._device
                )

                # ROCm exposes AMD GPUs through torch.cuda.
                self._use_half = True

                logger.info(
                    f"Face tracker GPU: {gpu_name} "
                    f"({vram_gb:.1f} GB)"
                )

            else:
                self._device = "cpu"
                self._use_half = False

                self.model.to(
                    self._device
                )

                logger.warning(
                    "Face tracker: GPU unavailable; "
                    "using CPU"
                )

            logger.info(
                f"{FACE_MODEL_NAME} loaded on "
                f"{self._device} "
                f"(FP16={self._use_half})"
            )

            # ----------------------------------------------------------
            # Warmup
            # ----------------------------------------------------------

            dummy = np.zeros(
                (FRAME_H, FRAME_W, 3),
                dtype=np.uint8,
            )

            logger.info(
                "Face tracker: GPU warmup..."
            )

            with torch.inference_mode():
                for _ in range(5):
                    self.model.predict(
                        dummy,
                        imgsz=INFERENCE_SIZE,
                        conf=0.5,
                        max_det=5,
                        verbose=False,
                        half=self._use_half,
                        device=self._device,
                    )

            if torch.cuda.is_available():
                torch.cuda.synchronize()

            logger.info(
                "Face tracker: GPU warmup complete"
            )

    # ------------------------------------------------------------------
    # Lifecycle
    # ------------------------------------------------------------------

    def start(self):
        if (
            self._active
            and self._thread
            and self._thread.is_alive()
        ):
            return

        self._active = True
        self._reset_state()

        self._thread = threading.Thread(
            target=self._run_loop,
            daemon=True,
            name="face-tracker",
        )

        self._thread.start()

    def stop(self):
        if not self._active:
            return

        self._active = False

        if self._thread:
            self._thread.join(
                timeout=5.0
            )

            self._thread = None

    def _reset_state(self):
        self._locked_id = None
        self._lock_lost_time = None

        self._smoothed_look_h = 0.0
        self._smoothed_look_v = 0.0

        self._idle_next_switch = 0.0
        self._idle_target_id = None

        self._last_detections = []

        self._fps = 0.0
        self._frame_count = 0
        self._detection_count = 0

        self._fps_timer = time.perf_counter()

    # ------------------------------------------------------------------
    # Screen capture
    # ------------------------------------------------------------------

    def _init_screen_capture(self):
        """
        Capture a centred 16:9 region.

        Capturing a smaller area reduces MSS memory bandwidth considerably
        compared with grabbing the complete 4K desktop.
        """

        import numpy as np

        try:
            import mss

            sct = mss.mss()

            monitor_cfg = int(
                getattr(
                    self.config,
                    "vision_monitor",
                    1,
                )
            )

            if (
                monitor_cfg <= 0
                or monitor_cfg >= len(sct.monitors)
            ):
                monitor_cfg = 1

            source = sct.monitors[
                monitor_cfg
            ]

            source_w = int(
                source["width"]
            )

            source_h = int(
                source["height"]
            )

            # Keep a central 16:9 region.
            capture_w = source_w
            capture_h = int(
                capture_w * 9 / 16
            )

            if capture_h > source_h:
                capture_h = source_h
                capture_w = int(
                    capture_h * 16 / 9
                )

            left = (
                int(source["left"])
                + (source_w - capture_w) // 2
            )

            top = (
                int(source["top"])
                + (source_h - capture_h) // 2
            )

            monitor = {
                "left": left,
                "top": top,
                "width": capture_w,
                "height": capture_h,
            }

            self._camera = sct

            logger.info(
                "Face tracker: MSS initialized "
                f"(monitor {monitor_cfg}: "
                f"{source_w}x{source_h}, "
                f"capture {capture_w}x{capture_h})"
            )

            def _grab_mss():
                shot = sct.grab(
                    monitor
                )

                frame = np.asarray(
                    shot,
                    dtype=np.uint8,
                )

                # BGRA -> BGR.
                return frame[:, :, :3]

            return _grab_mss

        except Exception as e:
            logger.exception(
                f"Face tracker screen capture init failed: {e}"
            )

            return None

    def _close_screen_capture(self):
        camera = self._camera

        if camera is None:
            return

        for method_name in (
            "stop",
            "release",
            "close",
        ):
            method = getattr(
                camera,
                method_name,
                None,
            )

            if not callable(method):
                continue

            try:
                method()
            except Exception:
                pass

        self._camera = None

    # ------------------------------------------------------------------
    # Memory maintenance
    # ------------------------------------------------------------------

    def _cleanup_inference_cache(
        self,
        torch_module=None,
    ):
        try:
            predictor = (
                getattr(
                    self.model,
                    "predictor",
                    None,
                )
                if self.model
                else None
            )

            if (
                predictor is not None
                and hasattr(
                    predictor,
                    "results",
                )
            ):
                predictor.results = None

            if (
                torch_module is not None
                and torch_module.cuda.is_available()
            ):
                torch_module.cuda.empty_cache()

        except Exception as e:
            logger.debug(
                "Face tracker cache cleanup "
                f"skipped: {e}"
            )

        try:
            gc.collect()
        except Exception:
            pass

    def _maybe_cleanup_inference_cache(
        self,
        torch_module,
    ):
        now = time.perf_counter()

        interval = float(
            self._cfg.get(
                "cache_cleanup_interval",
                300.0,
            )
        )

        if (
            interval > 0
            and now >= self._next_cache_cleanup
        ):
            self._cleanup_inference_cache(
                torch_module
            )

            self._next_cache_cleanup = (
                now + interval
            )

    # ------------------------------------------------------------------
    # Main loop
    # ------------------------------------------------------------------

    def _run_loop(self):
        import cv2
        import torch

        capture_fn = (
            self._init_screen_capture()
        )

        if capture_fn is None:
            logger.error(
                "Face tracker: no screen capture available, stopping"
            )

            self._active = False
            return

        if not self._preload_ready.is_set():
            logger.info(
                "Face tracker: waiting for model preload..."
            )

            self._preload_ready.wait(
                timeout=60
            )

        self._ensure_model()

        control_interval = (
            1.0 / TARGET_FPS
        )

        detection_interval = (
            1.0 / DETECTION_FPS
        )

        last_detection_time = 0.0

        logger.info(
            "Face tracker started | "
            f"control={TARGET_FPS} Hz | "
            f"detection={DETECTION_FPS} FPS | "
            f"input={FRAME_W}x{FRAME_H} | "
            f"imgsz={INFERENCE_SIZE}"
        )

        try:
            while self._active:
                loop_start = (
                    time.perf_counter()
                )

                # Mapping owns look controls.
                if self._mapping_nav_active():
                    time.sleep(
                        YIELD_SLEEP
                    )
                    continue

                # Other movement systems own OSC.
                if (
                    self._player_tracker_active()
                    or self._wanderer_active()
                ):
                    self._zero_osc()

                    time.sleep(
                        YIELD_SLEEP
                    )

                    continue

                # Keep the original behaviour:
                # no face tracking while explicitly idle.
                if self._is_idle():
                    self._zero_osc()

                    time.sleep(
                        YIELD_SLEEP
                    )

                    continue

                now = time.perf_counter()

                # ------------------------------------------------------
                # YOLO detection
                # ------------------------------------------------------

                if (
                    now - last_detection_time
                    >= detection_interval
                ):
                    capture_start = (
                        time.perf_counter()
                    )

                    frame = capture_fn()

                    self._last_capture_ms = (
                        time.perf_counter()
                        - capture_start
                    ) * 1000.0

                    if frame is not None:
                        resize_start = (
                            time.perf_counter()
                        )

                        resized = cv2.resize(
                            frame,
                            (
                                FRAME_W,
                                FRAME_H,
                            ),
                            interpolation=cv2.INTER_LINEAR,
                        )

                        self._last_resize_ms = (
                            time.perf_counter()
                            - resize_start
                        ) * 1000.0

                        infer_start = (
                            time.perf_counter()
                        )

                        with torch.inference_mode():
                            results = (
                                self.model.predict(
                                    resized,
                                    imgsz=INFERENCE_SIZE,
                                    conf=self._cfg[
                                        "confidence_threshold"
                                    ],
                                    max_det=5,
                                    verbose=False,
                                    half=self._use_half,
                                    device=self._device,
                                )
                            )

                        # Synchronize only for accurate timing.
                        if torch.cuda.is_available():
                            torch.cuda.synchronize()

                        self._last_inference_ms = (
                            time.perf_counter()
                            - infer_start
                        ) * 1000.0

                        self._last_detections = (
                            self._parse_faces(
                                results
                            )
                        )

                        self._detection_count += 1

                    last_detection_time = (
                        time.perf_counter()
                    )

                # ------------------------------------------------------
                # 60 Hz control path
                # ------------------------------------------------------

                self._update_tracking(
                    self._last_detections
                )

                self._send_osc()

                self._maybe_cleanup_inference_cache(
                    torch
                )

                self._frame_count += 1

                elapsed = (
                    time.perf_counter()
                    - self._fps_timer
                )

                if elapsed >= METRICS_INTERVAL:
                    self._fps = (
                        self._frame_count
                        / elapsed
                    )

                    detection_fps = (
                        self._detection_count
                        / elapsed
                    )

                    speaking = (
                        self._is_speaking()
                    )

                    mode = (
                        "speaking"
                        if speaking
                        else "tracking"
                    )

                    logger.info(
                        "Face tracker: "
                        f"control={self._fps:.1f} FPS | "
                        f"detection={detection_fps:.1f} FPS | "
                        f"faces={len(self._last_detections)} | "
                        f"mode={mode} | "
                        f"capture={self._last_capture_ms:.1f}ms | "
                        f"resize={self._last_resize_ms:.1f}ms | "
                        f"inference={self._last_inference_ms:.1f}ms | "
                        f"look_h={self._smoothed_look_h:.3f}"
                    )

                    self._frame_count = 0
                    self._detection_count = 0
                    self._fps_timer = (
                        time.perf_counter()
                    )

                # ------------------------------------------------------
                # 60 Hz limiter
                # ------------------------------------------------------

                loop_time = (
                    time.perf_counter()
                    - loop_start
                )

                remaining = (
                    control_interval
                    - loop_time
                )

                if remaining > 0:
                    time.sleep(
                        remaining
                    )

        except Exception as e:
            logger.exception(
                f"Face tracker loop error: {e}"
            )

        finally:
            self._zero_osc()

            self._cleanup_inference_cache(
                torch
                if "torch" in locals()
                else None
            )

            self._close_screen_capture()

            self._active = False

            logger.info(
                "Face tracker stopped "
                f"(last avg {self._fps:.1f} FPS)"
            )

    # ------------------------------------------------------------------
    # Detection parsing
    # ------------------------------------------------------------------

    def _parse_faces(
        self,
        results,
    ):
        detections = []

        if not results:
            return detections

        result = results[0]

        boxes = getattr(
            result,
            "boxes",
            None,
        )

        if boxes is None:
            return detections

        if len(boxes) == 0:
            return detections

        xyxy = (
            boxes.xyxy
            .detach()
            .cpu()
            .numpy()
        )

        confidences = (
            boxes.conf
            .detach()
            .cpu()
            .numpy()
        )

        for i, (
            box,
            confidence,
        ) in enumerate(
            zip(
                xyxy,
                confidences,
            )
        ):
            x1, y1, x2, y2 = (
                map(
                    float,
                    box,
                )
            )

            conf = float(
                confidence
            )

            cx = (
                x1 + x2
            ) / 2.0

            cy = (
                y1 + y2
            ) / 2.0

            width = (
                x2 - x1
            )

            height = (
                y2 - y1
            )

            area = (
                width * height
            ) / (
                FRAME_W * FRAME_H
            )

            norm_dx = (
                cx - FRAME_W / 2
            ) / (
                FRAME_W / 2
            )

            norm_dy = (
                cy - FRAME_H / 2
            ) / (
                FRAME_H / 2
            )

            center_dist = (
                norm_dx**2
                + norm_dy**2
            ) ** 0.5

            detections.append(
                {
                    "idx": i,
                    "cx": cx,
                    "cy": cy,
                    "norm_dx": norm_dx,
                    "norm_dy": norm_dy,
                    "area": area,
                    "center_dist": center_dist,
                    "conf": conf,
                }
            )

        return detections

    def _score(
        self,
        det,
    ):
        return (
            det["center_dist"]
            - det["area"] * 3.0
        )

    # ------------------------------------------------------------------
    # Target tracking
    # ------------------------------------------------------------------

    def _update_tracking(
        self,
        detections,
    ):
        cfg = self._cfg

        alpha = float(
            cfg["smoothing_alpha"]
        )

        now = time.time()

        speaking = (
            self._is_speaking()
        )

        if not detections:
            self._smoothed_look_h *= (
                1.0 - alpha
            )

            self._smoothed_look_v *= (
                1.0 - alpha
            )

            self._locked_id = None
            self._idle_target_id = None

            return

        if speaking:
            target = min(
                detections,
                key=self._score,
            )

        else:
            if (
                now >= self._idle_next_switch
                or self._idle_target_id is None
            ):
                target = random.choice(
                    detections
                )

                self._idle_target_id = (
                    target["idx"]
                )

                interval = random.uniform(
                    cfg["idle_switch_min"],
                    cfg["idle_switch_max"],
                )

                self._idle_next_switch = (
                    now + interval
                )

            else:
                target = min(
                    detections,
                    key=lambda d: abs(
                        d["norm_dx"]
                        - self._smoothed_look_h
                    ),
                )

        raw_look_h = max(
            -1.0,
            min(
                1.0,
                target["norm_dx"]
                * cfg["turn_gain"],
            ),
        )

        raw_look_v = max(
            -1.0,
            min(
                1.0,
                -target["norm_dy"]
                * cfg["vertical_gain"],
            ),
        )

        new_look_h = (
            self._smoothed_look_h
            * (1.0 - alpha)
            + raw_look_h * alpha
        )

        new_look_v = (
            self._smoothed_look_v
            * (1.0 - alpha)
            + raw_look_v * alpha
        )

        max_rate = float(
            cfg["max_turn_rate"]
        )

        delta_h = (
            new_look_h
            - self._smoothed_look_h
        )

        if abs(delta_h) > max_rate:
            new_look_h = (
                self._smoothed_look_h
                + max_rate
                * (
                    1
                    if delta_h > 0
                    else -1
                )
            )

        delta_v = (
            new_look_v
            - self._smoothed_look_v
        )

        if abs(delta_v) > max_rate:
            new_look_v = (
                self._smoothed_look_v
                + max_rate
                * (
                    1
                    if delta_v > 0
                    else -1
                )
            )

        self._smoothed_look_h = (
            new_look_h
        )

        self._smoothed_look_v = (
            new_look_v
        )

    # ------------------------------------------------------------------
    # OSC
    # ------------------------------------------------------------------

    def _send_osc(self):
        if not self.osc:
            return

        if (
            self._player_tracker_active()
            or self._wanderer_active()
            or self._mapping_nav_active()
        ):
            return

        client = self.osc.client
        cfg = self._cfg

        deadzone = float(
            cfg["deadzone"]
        )

        min_out = float(
            cfg["min_output"]
        )

        look_h = max(
            -1.0,
            min(
                1.0,
                self._smoothed_look_h,
            ),
        )

        look_v = max(
            -1.0,
            min(
                1.0,
                self._smoothed_look_v,
            ),
        )

        if abs(look_h) < deadzone:
            look_h = 0.0

        elif abs(look_h) < min_out:
            look_h = (
                min_out
                if look_h > 0
                else -min_out
            )

        if abs(look_v) < deadzone:
            look_v = 0.0

        client.send_message(
            "/input/LookHorizontal",
            float(look_h),
        )

        client.send_message(
            "/input/LookVertical",
            float(look_v),
        )

    def _zero_osc(self):
        if not self.osc:
            return

        try:
            self.osc.client.send_message(
                "/input/LookHorizontal",
                0.0,
            )

            self.osc.client.send_message(
                "/input/LookVertical",
                0.0,
            )

        except Exception as e:
            logger.debug(
                f"Face tracker OSC reset failed: {e}"
            )